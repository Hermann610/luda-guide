{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext",
    "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"], "noEmit": true, "strict": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["functions/**/*.ts", "server/**/*.ts"]
}
